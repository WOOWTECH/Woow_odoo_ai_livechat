<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tag of the AI bot partners (they are archived, like Odoo chatbots) -->
        <record id="partner_category_ai_bot" model="res.partner.category">
            <field name="name">AI 機器人</field>
        </record>

        <!-- Default AI Bot Partner: used as fallback author for AI-generated messages -->
        <record id="partner_ai_bot" model="res.partner">
            <field name="name">AI Assistant</field>
            <field name="active" eval="False"/>
            <field name="category_id" eval="[(4, ref('partner_category_ai_bot'))]"/>
            <field name="is_company" eval="False"/>
            <field name="type">contact</field>
        </record>

        <!-- Scheduled Action: Cleanup old API logs daily -->
        <record id="ir_cron_cleanup_llm_api_logs" model="ir.cron">
            <field name="name">Cleanup LLM API Logs</field>
            <field name="model_id" ref="model_llm_api_log"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Scheduled Action: run AI reply jobs left behind by a restart/crash -->
        <record id="ir_cron_recover_ai_jobs" model="ir.cron">
            <field name="name">Live Chat AI: Recover Reply Jobs</field>
            <field name="model_id" ref="model_im_livechat_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_recover_jobs()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
