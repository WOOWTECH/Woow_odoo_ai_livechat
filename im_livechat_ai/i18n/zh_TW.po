#. module: im_livechat_ai
#: model_terms:ir.ui.view,arch_db:im_livechat_ai.im_livechat_channel_view_form_inherit_ai
msgid ""
"<span invisible=\"not ai_api_token_set\">An access token is saved (it is never displayed). </span>\n"
"                                <span invisible=\"ai_api_token_set\">No access token saved yet. </span>\n"
"                                OpenAI compatible (LiteLLM, Hermes…): the base URL ending in /v1 and the\n"
"                                API key (sent as a Bearer token). n8n: the production webhook URL and,\n"
"                                optionally, a signing secret (Odoo then signs each request with\n"
"                                X-Woow-Signature and never sends the secret; without it, e.g. for a public\n"
"                                Chat Trigger, requests are not signed). Odoo only records, forwards and\n"
"                                manages the conversation: the backend decides the answer, its tools and its\n"
"                                permissions."
msgstr ""
"<span invisible=\"not ai_api_token_set\">已儲存存取金鑰（不會顯示）。</span>\n"
"                                <span invisible=\"ai_api_token_set\">尚未儲存存取金鑰。</span>\n"
"                                OpenAI 相容（LiteLLM、Hermes…）：填結尾為 /v1 的基礎網址與 API 金鑰（以 Bearer Token 送出）。n8n：填正式 Webhook 網址，簽章密鑰選填（填了 Odoo 會以 X-Woow-Signature 簽署每個請求，密鑰本身不會送出；不填則不簽章，例如公開的 Chat Trigger）。Odoo 只負責記錄、轉送與管理對話；回覆內容、工具與權限都由後端決定。"

