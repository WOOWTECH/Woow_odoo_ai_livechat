<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract 3.2: Live Chat managers read only the AI assistants a system administrator made available in
         Live Chat (the ones they may pick); system administrators read them all. -->
    <record id="rule_im_livechat_ai_assistant_livechat_manager" model="ir.rule">
        <field name="name">Live Chat AI assistants: Live Chat managers read those available in Live Chat</field>
        <field name="model_id" ref="model_im_livechat_ai_assistant"/>
        <field name="domain_force">[('livechat_available', '=', True)]</field>
        <field name="groups" eval="[(4, ref('im_livechat.im_livechat_group_manager'))]"/>
    </record>
    <record id="rule_im_livechat_ai_assistant_system" model="ir.rule">
        <field name="name">Live Chat AI assistants: system administrators read them all</field>
        <field name="model_id" ref="model_im_livechat_ai_assistant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
