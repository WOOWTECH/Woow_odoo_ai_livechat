{
 "contract": "v1.2",
 "about": "Backend answers (CONTRACT.md 3.6 and 3.7). Each case is one HTTP answer to one backend call; the harness serves it from a mocked requests.post and compares the normalized result of the product's own backend call with 'expect' (or 'expect_text_only' for products that post text only, where given).",
 "normalized": {
  "success": {
   "texts": "list of str, one per reply kept, <think> and special tokens removed",
   "attachments": "int, attachments of all kept replies (0 in text-only products)",
   "skip": "bool",
   "handoff": "bool",
   "reason": "str or null (handoff_reason, cleaned)",
   "tokens": "[prompt, completion, total], compared only when the case expects it"
  },
  "failure": {
   "error": "the call log status: invalid_response, http_error, timeout or error"
  }
 },
