<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Live Chat > Configuration > AI Assistants (system administrators): the persona visitors talk to.
         Live Chat managers pick one of the assistants available in Live Chat on a channel's AI Assistant tab. -->
    <record id="view_im_livechat_ai_assistant_list" model="ir.ui.view">
        <field name="name">im_livechat.ai.assistant.list</field>
        <field name="model">im_livechat.ai.assistant</field>
        <field name="arch" type="xml">
            <list string="AI Assistants">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="connection_id" groups="base.group_system"/>
                <field name="livechat_available" groups="base.group_system"/>
                <field name="customer_safe" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_im_livechat_ai_assistant_form" model="ir.ui.view">
        <field name="name">im_livechat.ai.assistant.form</field>
        <field name="model">im_livechat.ai.assistant</field>
        <field name="arch" type="xml">
            <form string="AI Assistant">
                <header groups="base.group_system">
                    <button name="action_test_connection" type="object" string="Test Connection"
                            invisible="not id or not connection_id" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="base.group_system">
                        <button name="action_view_call_logs" type="object" class="oe_stat_button" icon="fa-list-alt"
                                invisible="not id">
                            <field name="call_log_count" widget="statinfo" string="Call Logs"/>
                        </button>
                        <button name="action_open_bot_partner" type="object" class="oe_stat_button" icon="fa-user"
                                string="Bot Partner" invisible="not partner_id"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Store Assistant"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Shown to Live Chat managers when they choose the AI assistant of a channel"/>
                        <field name="connection_id" groups="base.group_system"
                               placeholder="Where the brain is: pick or create an AI connection"/>
                        <field name="livechat_available" groups="base.group_system"/>
                        <field name="customer_safe"/>
                        <field name="partner_id" readonly="1" invisible="not partner_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <div class="alert alert-info" role="status" groups="base.group_system"
                         invisible="customer_safe or not connection_id">
                        The AI connection of this AI assistant is not marked "Safe for Customers". Live Chat visitors
                        are mostly anonymous customers: the backend must only use public data.
                    </div>
                    <notebook groups="base.group_system">
                        <page string="Conversation" name="backend">
                            <group>
                                <group>
                                    <field name="max_history"/>
                                </group>
                                <group>
                                    <div class="text-muted" colspan="2">
                                        The backend type, URL, key, model, timeout and documents are settings of the
                                        AI connection. The welcome message, the handoff texts, the pause and wait
                                        minutes and the keywords are settings of each Live Chat channel.
                                    </div>
                                </group>
                            </group>
                            <group string="System Prompt">
                                <field name="system_prompt" nolabel="1" colspan="2"
                                       placeholder="Optional. Leave empty to let the backend decide the role."/>
                            </group>
                            <group string="Reply Processing" name="job_runner">
                                <field name="job_runner_warning" invisible="1"/>
                                <div colspan="2" class="alert alert-warning mb-2" role="alert"
                                     invisible="not job_runner_warning">
                                    Some replies may not be sent: see below.
                                </div>
                                <field name="job_runner_info" nolabel="1" colspan="2" readonly="1"/>
                            </group>
                        </page>
                        <page string="Messages" name="messages">
                            <group>
                                <field name="error_message" placeholder="Empty: a default message in the visitor's language"/>
                            </group>
                        </page>
                        <page string="Live Chat Channels" name="channels">
                            <field name="livechat_channel_summary" nolabel="1" readonly="1"/>
                            <div class="text-muted">
                                Live Chat managers choose the AI assistant of each channel (the channel's
                                "AI Assistant" tab), among the assistants available in Live Chat.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_im_livechat_ai_assistant_search" model="ir.ui.view">
        <field name="name">im_livechat.ai.assistant.search</field>
        <field name="model">im_livechat.ai.assistant</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="connection_id" groups="base.group_system"/>
                <filter name="livechat_available" string="Available in Live Chat"
                        domain="[('livechat_available', '=', True)]" groups="base.group_system"/>
                <filter name="customer_safe" string="Safe for Customers" domain="[('customer_safe', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_connection" string="AI Connection" context="{'group_by': 'connection_id'}"
                            groups="base.group_system"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_im_livechat_ai_assistant" model="ir.actions.act_window">
        <field name="name">AI Assistants</field>
        <field name="res_model">im_livechat.ai.assistant</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an AI assistant</p>
            <p>An AI assistant is the persona that answers Live Chat visitors; it uses an AI connection (a LiteLLM
                server or an n8n webhook). Tick "Available in Live Chat" so Live Chat managers can choose it for
                their channels.</p>
        </field>
    </record>

    <menuitem id="menu_im_livechat_ai_assistant"
              name="AI Assistants"
              parent="im_livechat.livechat_config"
              action="action_im_livechat_ai_assistant"
              groups="base.group_system"
              sequence="47"/>
</odoo>
