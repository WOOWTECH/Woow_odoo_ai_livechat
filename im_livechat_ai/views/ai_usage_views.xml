<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Live Chat > Configuration > AI Usage (system administrators): replies per month, kept permanently. -->
    <record id="view_im_livechat_ai_usage_month_list" model="ir.ui.view">
        <field name="name">im_livechat.ai.usage.month.list</field>
        <field name="model">im_livechat.ai.usage.month</field>
        <field name="arch" type="xml">
            <list string="AI Usage" create="0" edit="0" delete="0">
                <field name="month"/>
                <field name="assistant_id"/>
                <field name="connection_id" optional="show"/>
                <field name="livechat_channel_id" optional="show"/>
                <field name="surface_type" optional="hide"/>
                <field name="replies_ok" sum="Total"/>
                <field name="replies_failed" sum="Total" optional="show"/>
                <field name="prompt_tokens" sum="Total" optional="hide"/>
                <field name="completion_tokens" sum="Total" optional="hide"/>
                <field name="total_tokens" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_im_livechat_ai_usage_month_search" model="ir.ui.view">
        <field name="name">im_livechat.ai.usage.month.search</field>
        <field name="model">im_livechat.ai.usage.month</field>
        <field name="arch" type="xml">
            <search>
                <field name="assistant_id"/>
                <field name="connection_id"/>
                <field name="livechat_channel_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_month" string="Month" context="{'group_by': 'month:month'}"/>
                    <filter name="group_assistant" string="AI Assistant" context="{'group_by': 'assistant_id'}"/>
                    <filter name="group_connection" string="AI Connection" context="{'group_by': 'connection_id'}"/>
                    <filter name="group_channel" string="Live Chat Channel" context="{'group_by': 'livechat_channel_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_im_livechat_ai_usage_month" model="ir.actions.act_window">
        <field name="name">AI Usage</field>
        <field name="res_model">im_livechat.ai.usage.month</field>
        <field name="view_mode">list</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI reply yet</p>
            <p>Replies of the Live Chat AI assistants per month (UTC) and channel: a reference for invoicing by
                hand, never a limit (limits live in the LiteLLM keys). Counted from the upgrade to 18.0.2.0.0 on; kept
                permanently; the call logs are kept 30 days.</p>
        </field>
    </record>

    <menuitem id="menu_im_livechat_ai_usage_month"
              name="AI Usage"
              parent="im_livechat.livechat_config"
              action="action_im_livechat_ai_usage_month"
              groups="base.group_system"
              sequence="51"/>
</odoo>
