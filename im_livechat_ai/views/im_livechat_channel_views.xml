<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Live Chat > Configuration > Channels > AI Assistant tab (18.0.2.0.0): a Live Chat manager picks one of
         the AI assistants a system administrator made available in Live Chat and turns the AI on; the channel
         keeps its welcome and handoff texts, pause and wait minutes and keywords. The AI connections and
         assistants themselves are set up by system administrators (Live Chat > Configuration). Same xmlid as
         18.0.1.x: the view is rewritten in place on upgrade (no view is removed). -->
    <record id="im_livechat_channel_view_form_inherit_ai" model="ir.ui.view">
        <field name="name">im_livechat.channel.form.inherit.ai</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AI Assistant" name="ai_integration" groups="im_livechat.im_livechat_group_manager">
                    <group name="ai_assistant">
                        <group name="ai_assistant_pick">
                            <field name="ai_enabled"/>
                            <field name="ai_assistant_id" groups="base.group_system"
                                   options="{'no_quick_create': True}"/>
                            <field name="ai_assistant_id" groups="!base.group_system"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="ai_assistant_description" invisible="not ai_assistant_id"/>
                            <field name="ai_state" widget="badge"
                                   decoration-success="ai_state == 'ok'"
                                   decoration-danger="ai_state == 'blocked'"
                                   decoration-muted="ai_state == 'off'"/>
                        </group>
                        <group name="ai_assistant_status">
                            <div colspan="2" class="alert alert-warning" role="alert" invisible="not ai_state_reason">
                                <field name="ai_state_reason" nolabel="1" class="d-block"/>
                            </div>
                            <field name="ai_customer_safe_warning" invisible="1"/>
                            <div colspan="2" class="alert alert-info" role="status"
                                 invisible="not ai_customer_safe_warning">
                                The AI connection of this AI assistant is not marked "Safe for Customers". Live Chat
                                visitors are mostly anonymous customers: the backend must only use public data.
                            </div>
                            <div colspan="2" class="text-muted">
                                System administrators set up the AI assistants and their AI connections in
                                Live Chat > Configuration; only the assistants they made available in Live Chat can
                                be chosen here.
                            </div>
                            <div colspan="2" groups="base.group_system">
                                <button name="action_test_ai_connection"
                                        string="Test Connection"
                                        type="object"
                                        class="btn-primary"
                                        invisible="not ai_assistant_id"/>
                                <button name="action_view_api_logs"
                                        string="Call Logs"
                                        type="object"
                                        class="btn-link"/>
                            </div>
                        </group>
                    </group>

                    <group string="AI Welcome Message" invisible="not ai_enabled">
                        <field name="ai_welcome_message" nolabel="1" colspan="2"/>
                        <div class="text-muted" colspan="2">
                            While AI is enabled, visitors see this welcome message instead of the
                            channel welcome message, so they know they are talking to an AI.
                        </div>
                    </group>

                    <group string="Human Handoff" invisible="not ai_enabled">
                        <field name="ai_handoff_pause_minutes"/>
                        <field name="ai_handoff_wait_minutes"/>
                        <field name="ai_handoff_keywords"/>
                        <field name="ai_handoff_message"/>
                        <field name="ai_pause_notice"/>
                        <div class="text-muted" colspan="2">
                            When an operator posts in a conversation, the AI stays silent for the pause
                            minutes (every operator message extends it). When the visitor asks for a human
                            (the AI backend decides, or one of the keywords), the visitor gets the handoff
                            message, the operators are notified and the AI waits for an operator; the first
                            visitor message during the wait gets the waiting notice once. If no operator
                            replies before the wait ends, the AI answers the messages the visitor wrote
                            meanwhile.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
