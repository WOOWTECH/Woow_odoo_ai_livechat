<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="llm_api_log_view_tree" model="ir.ui.view">
        <field name="name">llm.api.log.tree</field>
        <field name="model">llm.api.log</field>
        <field name="arch" type="xml">
            <list string="Call Logs" create="false">
                <field name="timestamp" widget="datetime"/>
                <field name="livechat_channel_id"/>
                <field name="discuss_channel_id"/>
                <field name="assistant_id" optional="show"/>
                <field name="connection_id" optional="hide"/>
                <field name="backend_type" optional="show"/>
                <field name="model" optional="show"/>
                <field name="status"
                       decoration-success="status in ('ok', 'success')"
                       decoration-danger="status in ('http_error', 'timeout', 'invalid_response', 'error')"
                       decoration-warning="status == 'retry'"/>
                <field name="total_tokens"/>
                <field name="duration_ms" optional="show"/>
                <field name="http_status" optional="show"/>
                <field name="retry_count"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="llm_api_log_view_form" model="ir.ui.view">
        <field name="name">llm.api.log.form</field>
        <field name="model">llm.api.log</field>
        <field name="arch" type="xml">
            <form string="Call Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="timestamp"/>
                            <field name="status"/>
                            <field name="http_status"/>
                            <field name="backend_type"/>
                            <field name="model"/>
                            <field name="livechat_channel_id"/>
                            <field name="discuss_channel_id"/>
                            <field name="assistant_id"/>
                            <field name="connection_id"/>
                            <field name="job_id"/>
                        </group>
                        <group name="performance" string="Performance &amp; Usage">
                            <field name="duration_ms"/>
                            <field name="response_time"/>
                            <field name="retry_count"/>
                            <field name="prompt_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="total_tokens"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_payload" widget="text" nolabel="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_payload" widget="text" nolabel="1"/>
                        </page>
                        <page string="Error" name="error" invisible="status in ('ok', 'success')">
                            <field name="error_message" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="llm_api_log_view_search" model="ir.ui.view">
        <field name="name">llm.api.log.search</field>
        <field name="model">llm.api.log</field>
        <field name="arch" type="xml">
            <search string="Search Call Logs">
                <!-- Search Fields -->
                <field name="livechat_channel_id"/>
                <field name="discuss_channel_id"/>
                <field name="assistant_id"/>
                <field name="connection_id"/>
                <field name="backend_type"/>
                <field name="model"/>
                <field name="status"/>

                <!-- Filters -->
                <filter name="filter_success" string="OK" domain="[('status', 'in', ('ok', 'success'))]"/>
                <filter name="filter_error" string="Failed"
                        domain="[('status', 'in', ('http_error', 'timeout', 'invalid_response', 'error'))]"/>
                <filter name="filter_retry" string="Retry (1.x)" domain="[('status', '=', 'retry')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('timestamp', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('timestamp', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="filter_last_7_days" string="Last 7 Days"
                        domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_last_30_days" string="Last 30 Days"
                        domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="group_by_channel" string="Channel" context="{'group_by': 'livechat_channel_id'}"/>
                    <filter name="group_by_assistant" string="AI Assistant" context="{'group_by': 'assistant_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="llm_api_log_action" model="ir.actions.act_window">
        <field name="name">Call Logs</field>
        <field name="res_model">llm.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_last_7_days': 1}</field>
        <!-- (6, 0, ...): replace the 18.0.1.x group (Live Chat managers) on upgraded databases too -->
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No call logs found
            </p>
            <p>
                A log is created for every answer of the AI backend of a
                Live Chat channel; logs are kept 30 days.
            </p>
        </field>
    </record>

    <!-- Menu Item (system administrators; "-group" unlinks the 18.0.1.x group on upgraded databases) -->
    <menuitem id="llm_api_log_menu"
              name="Call Logs"
              parent="im_livechat.livechat_config"
              action="llm_api_log_action"
              groups="-im_livechat.im_livechat_group_manager,base.group_system"
              sequence="50"/>
</odoo>
