<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings > Live Chat AI: system-wide LiteLLM connection and log privacy (admins only) -->
    <record id="res_config_settings_view_form_livechat_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.im_livechat_ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Live Chat AI" string="Live Chat AI" name="im_livechat_ai"
                     logo="/im_livechat/static/description/icon.png"
                     groups="base.group_system">
                    <block title="LiteLLM Connection" name="livechat_ai_connection">
                        <setting id="livechat_ai_base_url_setting" string="LiteLLM Base URL"
                                 help="Company LiteLLM gateway shared by every Live Chat channel">
                            <field name="livechat_ai_base_url"
                                   placeholder="https://paas-cs-32e92be2-5b2e4e66.woowtech.io/v1"/>
                        </setting>
                        <setting id="livechat_ai_api_key_setting" string="LiteLLM API Key"
                                 help="Use the dedicated odoo-livechat key. Leave empty to keep the current key.">
                            <field name="livechat_ai_api_key" password="True"
                                   placeholder="sk-..."/>
                            <field name="livechat_ai_api_key_set" invisible="1"/>
                            <div class="text-success" invisible="not livechat_ai_api_key_set">
                                A key is configured (it is never displayed).
                            </div>
                            <div class="text-warning" invisible="livechat_ai_api_key_set">
                                No key configured yet: AI replies stay off.
                            </div>
                        </setting>
                        <setting id="livechat_ai_models_setting" string="Available Models"
                                 help="Models offered in the channel model selector">
                            <field name="livechat_ai_model_list" readonly="1"
                                   placeholder="Not fetched yet"/>
                            <div class="mt8">
                                <button name="action_livechat_ai_fetch_models" type="object"
                                        string="Fetch Available Models" icon="oi-arrow-right"
                                        class="btn-link"/>
                                <button name="action_livechat_ai_test_connection" type="object"
                                        string="Test Connection" icon="oi-arrow-right"
                                        class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Reply Jobs" name="livechat_ai_jobs">
                        <setting id="livechat_ai_jobs_monitoring_setting" string="Recovery Cron &amp; Reply Jobs"
                                 help="Replies after a restart or deploy, and the AI answers after an unanswered handoff wait, are sent by the cron &quot;Live Chat AI: Recover Reply Jobs&quot; (every 2 minutes). A cron process must be running.">
                            <div class="row mt8">
                                <label for="livechat_ai_cron_lastcall" class="col-lg-6 o_light_label"/>
                                <field name="livechat_ai_cron_lastcall" readonly="1" class="col-lg-6"/>
                            </div>
                            <div class="row">
                                <label for="livechat_ai_stale_job_count" class="col-lg-6 o_light_label"/>
                                <field name="livechat_ai_stale_job_count" readonly="1" class="col-lg-6"/>
                            </div>
                            <div class="alert alert-warning mt8" role="alert" invisible="not livechat_ai_job_warning">
                                <field name="livechat_ai_job_warning" readonly="1"/>
                            </div>
                            <div class="text-success mt8" invisible="livechat_ai_job_warning">
                                The recovery cron ran in the last 5 minutes and no reply job is stuck.
                            </div>
                        </setting>
                    </block>
                    <block title="API Logs &amp; Privacy" name="livechat_ai_logs">
                        <setting id="livechat_ai_log_payload_setting" string="Log Conversation Content"
                                 help="Keep the messages exchanged with the LLM in the API logs. Turn on only while debugging; turning it off erases stored content.">
                            <field name="livechat_ai_log_payload"/>
                        </setting>
                        <setting id="livechat_ai_log_retention_setting" string="Log Retention (days)"
                                 help="API logs older than this are deleted every day">
                            <field name="livechat_ai_log_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_action_livechat_ai" model="ir.actions.act_window">
        <field name="name">Live Chat AI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'im_livechat_ai', 'bin_size': False}</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <menuitem id="livechat_ai_settings_menu"
              name="AI Settings"
              parent="im_livechat.livechat_config"
              action="res_config_settings_action_livechat_ai"
              groups="base.group_system"
              sequence="49"/>
</odoo>
