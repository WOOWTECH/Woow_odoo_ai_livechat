# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Generate a password, e.g.:  openssl rand -base64 24

POSTGRES_DB=odooailivechat
POSTGRES_USER=odooailivechat
POSTGRES_PASSWORD=

# Host port for the Odoo web interface (http://localhost:9094)
ODOO_PORT=9094

# The AI backend URL and key are NOT configured here: a system administrator
# sets the AI connection and the AI assistant in Odoo (Live Chat >
# Configuration > AI Connections and AI Assistants); a Live Chat manager picks
# the assistant on the channel's "AI Assistant" tab.
